# Reference document (PDF, DOCX, TXT, or Markdown). Relative paths use the project root.
DOCUMENT_PATH=data/student-handbook.pdf

# Generated vector index.
INDEX_DIR=index

# Local embedding model. Downloaded once from Hugging Face, then served offline.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Chunking and retrieval.
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
TOP_K=4
# Cosine similarity floor. 0.0 keeps normal positive matches; raise it to filter weak evidence.
MIN_SCORE=0.0

# Any OpenAI-compatible chat endpoint.
# Default: local Ollama (https://ollama.com) at http://localhost:11434/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2
# Leave empty for local Ollama. Required for most hosted providers.
LLM_API_KEY=
LLM_TIMEOUT=120
